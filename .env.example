# ImageKit base URL used for site images
VITE_IMAGEKIT_URL=

# Hygraph Content API endpoint (Project settings → Endpoints → "Content API").
# Make sure public read access is enabled for the Content API
# (Project settings → Access → API Access → Public Content API → add "Published" read permission).
# Do NOT put a Permanent Auth Token here: VITE_ variables are bundled into the client.
VITE_HYGRAPH_ENDPOINT=https://<region>.cdn.hygraph.com/content/<project-id>/master
